{
  "name": "@stethoscope-js/action",
  "version": "1.2.11",
  "description": "GitHub Action to track your life data using Stethoscope",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build --source-map",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stethoscope-js/action.git"
  },
  "keywords": [
    "github",
    "github actions",
    "nodejs",
    "typescript",
    "starter"
  ],
  "author": "Anand Chowdhary <mail@anandchowdhary.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/stethoscope-js/action/issues"
  },
  "homepage": "https://github.com/stethoscope-js/action#readme",
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@types/dot-object": "^2.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/recursive-readdir": "^2.2.1",
    "@vercel/ncc": "^0.45.0",
    "fs-extra": "^11.4.1",
    "jest": "30.5.2",
    "semantic-release": "^25.0.9",
    "semantic-release-gitmoji": "^1.6.9",
    "ts-jest": "^29.0.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@stethoscope-js/integrations": "^2.4.5",
    "dot-object": "^2.1.4",
    "recursive-readdir": "^2.2.3"
  },
  "overrides": {
    "@toplast/lastfm": {
      "axios": "^1.20.0"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "automock": false
  }
}
